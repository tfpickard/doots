adjust-underline-position = 8
adjust-underline-thickness = 2
# auto-update = "stable"  # was "tip" - removed as this option doesn't exist
# cursor-invert-fg-bg = true  # deprecated -> migrated to cursor-color/cursor-text below
cursor-color = cell-foreground
cursor-text = cell-background
custom-shader-animation = "always"

macos-icon = "custom-style"
macos-icon-frame = "aluminum"
macos-icon-ghost-color = "86e1fc"
macos-icon-screen-color = "222436"

# macos-option-as-alt = "both"  # values: left|right|both|none
mouse-hide-while-typing = true
# font-thicken is tuned per-font in font/<name>; don't set it here (the include
# loads after this file and would override it anyway).
alpha-blending = linear-corrected

macos-window-shadow = true

# OS-specific settings (e.g. the quick-terminal keybind, which only works on
# macOS) live in os/macos.conf and os/linux.conf. `make ghostty` creates the
# os/active symlink pointing at the right one for this machine. The leading `?`
# makes the include optional, so a machine without the symlink still loads clean.
config-file = ?os/active

config-file = font/monaspace-neon
config-file = leading/default
# Theme comes from the global theme system: ~/.config/themes/active is a
# symlink flipped by `theme-set` (see ~/.config/themes/theme-set). The
# theme/active symlink below points into it. Old static picks kept for
# reference:
# config-file = theme/vague
# config-file = theme/catppuccin-mocha
config-file = ?theme/active
config-file = opacity/85%
# config-file = shader/starfield
# config-file = shader/matrix-hallway
config-file = shader/none

# vim: ft=config
