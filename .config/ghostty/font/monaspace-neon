# Primary font - GitHub's revolutionary Monaspace
font-family = "Monaspace Neon"

# Nerd Font fallback for icons: Monaspace has no icon glyphs, so prompts and
# `eza --icons` would render tofu without this. Ghostty treats repeated
# font-family lines as fallbacks, in order.
font-family = "JetBrainsMono Nerd Font"

# Modern font settings
font-size = 14
font-thicken = false
# font-feature = [
#     "calt",  # Contextual alternates
#     "liga",  # Ligatures  
#     "ss01",  # Stylistic set 1
#     "ss02",  # Stylistic set 2
#     "ss03",  # Stylistic set 3
# ]
#
adjust-cell-width = 0
adjust-cell-height = 0
adjust-font-baseline = 0

# 🔹 INSTALL COMMANDS
# bash
# # Install Monaspace
# brew install font-monaspace
#
# # Install Nerd Font fallback
# brew install font-jetbrains-mono-nerd-font
#
# # Restart Ghostty
