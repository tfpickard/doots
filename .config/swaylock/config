# ~/.config/swaylock/config -- lock screen
#
# READ THIS FIRST: which swaylock do you have?
#
#     swaylock --version
#
# This file is written for **vanilla swaylock 1.7.2** (the Debian/Ubuntu
# package). Vanilla swaylock has NO blur, NO clock, NO fade, NO screenshot
# background -- those belong to the swaylock-effects fork, which is
# unmaintained and not packaged for Ubuntu. Options it doesn't know are printed
# to stderr as "unrecognized option" and then IGNORED; the lock still comes up,
# you just silently don't get the feature. That is why the effects options
# below are commented out and clearly labelled.
#
# Syntax: long option names with the leading dashes removed. Flags are bare
# words, options with values use `key=value` and the `=` is required.
# Every color is `rrggbb` or `rrggbbaa` with NO leading '#'.
#
# Test changes without waiting for the idle timeout:
#     swaylock --debug          # then unlock normally
# Colours are managed by ~/.config/themes/theme-set; see the include note at
# the bottom of this file.

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Pressing Enter on an empty password does nothing, instead of counting as a
# failed attempt. Stops a cat on the keyboard from locking you into a long
# PAM backoff.
ignore-empty-password

# Show "N failed attempts" -- a cheap tell that someone poked at your laptop.
show-failed-attempts

# Show which keyboard layout is active while typing. Worth enabling if you use
# more than one layout, since typing a password blind into the wrong one is
# maddening. (Hide it explicitly with hide-keyboard-layout.)
# show-keyboard-layout

# Daemonize: return control to the shell once the screen is locked.
# swayidle already runs `swaylock -f`, so this is here for manual invocations.
# daemonize

# Treat the password field as ready as soon as the lock appears, rather than
# waiting for the first keystroke to draw the indicator.
# indicator-idle-visible

# ---------------------------------------------------------------------------
# Background -- Silicon Graphics
# ---------------------------------------------------------------------------
#
# The lock screen is deliberately pinned to the SGI palette (#29558e indigo and
# white) rather than following the desktop theme. The background image is a
# fixed SGI lockup, so theme-coloured rings on top of it would just clash.
# There are therefore NO "THEME:" markers in this file any more -- theme-set
# skips it, which is why switching themes no longer restyles the lock.
#
# To go back to theme-following, put the markers back: a comment line
# "# THEME:lock-ring" directly above a "ring-color=..." line is all it takes,
# and theme-set will patch the value under it. See the swaync/fnott configs for
# examples.
#
# The per-output background images are generated by
# ~/.config/scripts/lock-background.py, which lifts the white logo out of
# ~/Pictures/Wallpaper/indigo.png and re-composites it, crisply, at each
# monitor's exact resolution. ~/.config/scripts/lock.sh regenerates them and
# passes the right `-i output:path` pairs, because swaylock can't glob them
# itself. That is why you should lock via lock.sh rather than calling swaylock
# directly.

# Fallback flat colour: the SGI field blue, sampled from the wallpaper. Used on
# any output that has no generated image yet (e.g. a monitor hotplugged while
# the screen is already locked).
color=29558e

# How the generated image is fitted. It is rendered at the exact output size,
# so this only matters for the fallback cases above.
scaling=fill

# ---------------------------------------------------------------------------
# Unlock indicator
# ---------------------------------------------------------------------------
#
# The ring sits dead centre; lock-background.py deliberately places the logo
# above centre so the two don't collide.
#
# A bare `indicator` line is a swaylock-EFFECTS option: on vanilla swaylock it
# collides with --indicator-radius and friends and swaylock exits with
# "option '--indicator' is ambiguous". The ring is drawn by default anyway.
indicator-radius=110
indicator-thickness=8

# Also show Caps Lock state in the ring colours.
indicator-caps-lock

# For a completely blank lock screen with no feedback at all:
# no-unlock-indicator

# ---------------------------------------------------------------------------
# Typography
# ---------------------------------------------------------------------------
font=JetBrainsMono Nerd Font

# ---------------------------------------------------------------------------
# Colours -- SGI indigo and white
# ---------------------------------------------------------------------------
#
# swaylock has five indicator STATES:
#   (default)   idle, waiting for input
#   -ver-       verifying the password with PAM
#   -wrong-     authentication failed
#   -clear-     input was cleared
#   -caps-lock- Caps Lock is on (needs indicator-caps-lock, set above)
#
# and four PARTS: inside- (the disc), ring- (the ring), line- (the hairline
# between them) and text- (the status text).
#
# Colours are rrggbb or rrggbbaa, with NO leading '#'. The 8-digit values below
# are deliberately translucent so the SGI blue shows through the disc.
#
# CAREFUL: swaylock does NOT strip trailing "#" comments. A line like
#     ring-color=ffffff  # white
# is parsed as the literal colour "ffffff  # white" and silently falls back to
# white. Keep comments on their own lines.

# --- idle: white ring on the indigo field, like the logo ---
inside-color=14294dcc
ring-color=ffffff
text-color=ffffff

# Hairline and segment separators, transparent for a clean unbroken ring.
line-color=00000000
separator-color=00000000

# --- keypress feedback ---
# The ring breaks into segments as you type. Light blue for a keypress, warm
# for a backspace, so the two are distinguishable at a glance.
key-hl-color=8fc0ff
bs-hl-color=f0a068

# --- verifying ---
inside-ver-color=14294dcc
ring-ver-color=8fc0ff
text-ver-color=8fc0ff

# --- wrong ---
inside-wrong-color=14294dcc
ring-wrong-color=e8706b
text-wrong-color=e8706b

# --- cleared ---
inside-clear-color=14294dcc
ring-clear-color=66c98a
text-clear-color=66c98a

# --- caps lock ---
inside-caps-lock-color=14294dcc
ring-caps-lock-color=f0cd6b
text-caps-lock-color=f0cd6b
caps-lock-key-hl-color=f0cd6b
caps-lock-bs-hl-color=f0a068

# --- keyboard layout box (only drawn with show-keyboard-layout) ---
layout-bg-color=14294dcc
layout-border-color=ffffff
layout-text-color=ffffff

# ===========================================================================
# NOT AVAILABLE in vanilla swaylock -- swaylock-effects fork only
# ===========================================================================
#
# Everything in this block is silently ignored by swaylock 1.7.2. It is listed
# so you know what the fork buys you, and so the options are ready to
# uncomment if you ever install it. Build it from
# https://github.com/mortie/swaylock-effects (note: unmaintained since 2022;
# jirutka's fork is the maintained one).
#
# A digital clock in the centre of the indicator, with strftime formatting.
# THIS IS THE ONE THAT WAS IN THIS FILE BEFORE and never worked here.
# clock
# timestr=%H:%M
# datestr=%a %e %B %Y
#
# Use a screenshot of the desktop as the lock background, then post-process it.
# This is the "frosted glass over your actual desktop" look.
# screenshots
# effect-blur=7x5
# effect-pixelate=8
# effect-scale=0.4
# effect-greyscale
# effect-vignette=0.5:0.5
#
# Fade the lock in rather than snapping to it.
# fade-in=0.3
#
# Grace period: accept input for N seconds before actually requiring a
# password, so a stray touchpad brush doesn't force a full re-auth.
# grace=2
# grace-no-mouse
# grace-no-touch
#
# Draw an indicator on every output, not just the focused one.
# indicator-idle-visible
#
# ===========================================================================
# Theme integration
# ===========================================================================
#
# swaylock has no include/@import mechanism, so this file cannot source the
# palette the way waybar's CSS does. Other configs (swaync, fnott,
# swaylock-effects) get their colours rewritten in place by
# ~/.config/themes/theme-set, which patches the value on the line directly
# below each "# THEME:<key>" marker comment.
#
# This file deliberately has NO such markers: the lock is pinned to SGI so it
# always matches its background image. theme-set is a no-op here as a result --
# it only substitutes where a marker matches. Add markers back if you want the
# lock to follow the desktop theme again.
#
# ===========================================================================
# Want actual animation on the lock screen?
# ===========================================================================
#
# You can't composite xscreensaver (or anything else) on top of swaylock.
# Under the ext-session-lock protocol the compositor renders ONLY the lock
# surface while locked -- niri explicitly skips windows and layer-shell in that
# state (src/niri.rs, is_locked() branch), so there is nowhere for another
# client to draw. The lock screen has to animate itself.
#
# Options, in increasing order of effort:
#
#   1. Screensaver BEFORE the lock, not on top of it.
#      swayidle runs a vintage GL hack on every monitor after 10 minutes, and
#      locks for real at 45. See ~/.config/scripts/lock-screensaver.py. This is
#      the closest thing to xscreensaver's behaviour and needs no new packages.
#
#   2. hyprlock -- available from the Hyprland PPA you already have, and it
#      does NOT depend on Hyprland (it's a generic ext-session-lock client).
#      Supports blur, animated shaders, per-output wallpapers, and arbitrary
#      command output on the lock screen. The obvious upgrade if you want a
#      genuinely animated lock.
#
#   3. swaylock-effects -- blur/screenshot/clock, but a static image. Built
#      to ~/.local/bin; see .config/swaylock-effects/config.
