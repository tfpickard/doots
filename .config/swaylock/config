# ~/.config/swaylock/config -- lock screen
#
# READ THIS FIRST: which swaylock do you have?
#
#     swaylock --version
#
# This file is written for **vanilla swaylock 1.7.2** (the Debian/Ubuntu
# package). Vanilla swaylock has NO blur, NO clock, NO fade, NO screenshot
# background -- those belong to the swaylock-effects fork, which is
# unmaintained and not packaged for Ubuntu. Options it doesn't know are printed
# to stderr as "unrecognized option" and then IGNORED; the lock still comes up,
# you just silently don't get the feature. That is why the effects options
# below are commented out and clearly labelled.
#
# Syntax: long option names with the leading dashes removed. Flags are bare
# words, options with values use `key=value` and the `=` is required.
# Every color is `rrggbb` or `rrggbbaa` with NO leading '#'.
#
# Test changes without waiting for the idle timeout:
#     swaylock --debug          # then unlock normally
# Colours are managed by ~/.config/themes/theme-set; see the include note at
# the bottom of this file.

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Pressing Enter on an empty password does nothing, instead of counting as a
# failed attempt. Stops a cat on the keyboard from locking you into a long
# PAM backoff.
ignore-empty-password

# Show "N failed attempts" -- a cheap tell that someone poked at your laptop.
show-failed-attempts

# Show which keyboard layout is active while typing. Worth enabling if you use
# more than one layout, since typing a password blind into the wrong one is
# maddening. (Hide it explicitly with hide-keyboard-layout.)
# show-keyboard-layout

# Daemonize: return control to the shell once the screen is locked.
# swayidle already runs `swaylock -f`, so this is here for manual invocations.
# daemonize

# Treat the password field as ready as soon as the lock appears, rather than
# waiting for the first keystroke to draw the indicator.
# indicator-idle-visible

# ---------------------------------------------------------------------------
# Background
# ---------------------------------------------------------------------------

# Flat colour. Overridden by `image` if that is set.
# Managed by theme-set -- see the note at the end.
# THEME:lock-bg
color=0f1113

# A wallpaper instead of a flat colour. Both forms work:
#     image=/path/to/file.png                 (all outputs)
#     image=eDP-1:/path/to/file.png           (one output; repeat per output)
# image=~/Pictures/Wallpaper/default

# How `image` is fitted: stretch | fill | fit | center | tile | solid_color
# scaling=fill

# ---------------------------------------------------------------------------
# Unlock indicator -- the ring in the middle
# ---------------------------------------------------------------------------

# The ring is drawn by default in vanilla swaylock, so there is nothing to
# switch on here. (A bare `indicator` line is a swaylock-EFFECTS option; on
# vanilla it collides with --indicator-radius etc. and swaylock exits with
# "option '--indicator' is ambiguous". It was in this file before and is
# deliberately not here now.)
#
# To get a completely blank lock screen with no feedback at all, uncomment:
# no-unlock-indicator

indicator-radius=110
indicator-thickness=10

# Move the ring off centre. Both default to the middle of each output.
# Useful with a wallpaper whose subject sits in the centre.
# indicator-x-position=960
# indicator-y-position=540

# Also reflect Caps Lock state in the ring colours (see caps-lock colours
# below). Saves you from typing a whole password in caps.
indicator-caps-lock

# Suppress the "Caps Lock" text while keeping the colour change above.
# disable-caps-lock-text

# ---------------------------------------------------------------------------
# Typography
# ---------------------------------------------------------------------------

font=JetBrainsMono Nerd Font

# Fixed point size. Left off so swaylock scales the text to the indicator,
# which keeps it sensible if you change indicator-radius.
# font-size=24

# ---------------------------------------------------------------------------
# Colours
# ---------------------------------------------------------------------------
#
# swaylock has five indicator STATES, and every part of the ring can be
# coloured per state:
#
#   (default)   idle, waiting for input
#   -ver-       verifying the password with PAM
#   -wrong-     authentication failed
#   -clear-     input was cleared (Esc, or the backspace-everything case)
#   -caps-lock- Caps Lock is on (only used when indicator-caps-lock is set)
#
# and four PARTS:
#
#   inside-     the disc in the middle of the ring
#   ring-       the ring itself
#   line-       the hairline between inside and ring
#   text-       the status text drawn inside the ring
#
# Colours below are cyberdream and are rewritten in place by theme-set. The
# "THEME:" marker comments are load-bearing -- don't remove them.

# --- idle -------------------------------------------------------------------
# THEME:lock-inside
inside-color=1e2124
# THEME:lock-ring
ring-color=7b8496
# THEME:lock-text
text-color=ffffff

# Hairline and segment separators. Fully transparent gives the clean
# "floating ring" look; set them to a real colour for a more segmented,
# technical feel.
line-color=00000000
separator-color=00000000

# Instead of a colour, the line can borrow from its neighbours:
# line-uses-inside
# line-uses-ring

# --- keypress feedback ------------------------------------------------------
# swaylock splits the ring into segments as you type: key-hl for a keypress,
# bs-hl for a backspace. This is the main piece of "it's alive" feedback.
# THEME:lock-keyhl
key-hl-color=bd5eff
# THEME:lock-bshl
bs-hl-color=ff6e5e

# --- verifying --------------------------------------------------------------
# THEME:lock-inside
inside-ver-color=1e2124
# THEME:lock-ver
ring-ver-color=5ea1ff
# THEME:lock-ver
text-ver-color=5ea1ff

# --- wrong ------------------------------------------------------------------
# THEME:lock-inside
inside-wrong-color=1e2124
# THEME:lock-wrong
ring-wrong-color=ff6e5e
# THEME:lock-wrong
text-wrong-color=ff6e5e

# --- cleared ----------------------------------------------------------------
# THEME:lock-inside
inside-clear-color=1e2124
# THEME:lock-clear
ring-clear-color=5eff6c
# THEME:lock-clear
text-clear-color=5eff6c

# --- caps lock --------------------------------------------------------------
# THEME:lock-inside
inside-caps-lock-color=1e2124
# THEME:lock-caps
ring-caps-lock-color=ffbd5e
# THEME:lock-caps
text-caps-lock-color=ffbd5e
# THEME:lock-caps
caps-lock-key-hl-color=ffbd5e
# THEME:lock-bshl
caps-lock-bs-hl-color=ff6e5e

# --- keyboard layout box ----------------------------------------------------
# Only drawn when show-keyboard-layout is enabled above.
# THEME:lock-inside
layout-bg-color=1e2124
# THEME:lock-ring
layout-border-color=7b8496
# THEME:lock-text
layout-text-color=ffffff

# ===========================================================================
# NOT AVAILABLE in vanilla swaylock -- swaylock-effects fork only
# ===========================================================================
#
# Everything in this block is silently ignored by swaylock 1.7.2. It is listed
# so you know what the fork buys you, and so the options are ready to
# uncomment if you ever install it. Build it from
# https://github.com/mortie/swaylock-effects (note: unmaintained since 2022;
# jirutka's fork is the maintained one).
#
# A digital clock in the centre of the indicator, with strftime formatting.
# THIS IS THE ONE THAT WAS IN THIS FILE BEFORE and never worked here.
# clock
# timestr=%H:%M
# datestr=%a %e %B %Y
#
# Use a screenshot of the desktop as the lock background, then post-process it.
# This is the "frosted glass over your actual desktop" look.
# screenshots
# effect-blur=7x5
# effect-pixelate=8
# effect-scale=0.4
# effect-greyscale
# effect-vignette=0.5:0.5
#
# Fade the lock in rather than snapping to it.
# fade-in=0.3
#
# Grace period: accept input for N seconds before actually requiring a
# password, so a stray touchpad brush doesn't force a full re-auth.
# grace=2
# grace-no-mouse
# grace-no-touch
#
# Draw an indicator on every output, not just the focused one.
# indicator-idle-visible
#
# ===========================================================================
# Theme integration
# ===========================================================================
#
# swaylock has no include/@import mechanism, so this file cannot source the
# palette the way waybar's CSS does. Instead ~/.config/themes/theme-set
# rewrites the colour lines tagged "# THEME:<key>" above, in place, the same
# trick it uses for the niri config. Add a theme by giving its palette.json
# the keys theme-set maps to those tags.
#
# ===========================================================================
# Want actual animation on the lock screen?
# ===========================================================================
#
# You can't composite xscreensaver (or anything else) on top of swaylock.
# Under the ext-session-lock protocol the compositor renders ONLY the lock
# surface while locked -- niri explicitly skips windows and layer-shell in that
# state (src/niri.rs, is_locked() branch), so there is nowhere for another
# client to draw. The lock screen has to animate itself.
#
# Options, in increasing order of effort:
#
#   1. Screensaver BEFORE the lock, not on top of it.
#      Have swayidle run the xscreensaver hack at a short timeout and swaylock
#      at a longer one. You get animation while merely idle, and a real lock
#      once you've been away a while. ~/.config/scripts/lock-screensaver.sh
#      does exactly this. This is the closest thing to xscreensaver's
#      behaviour and needs no new packages.
#
#   2. hyprlock -- available from the Hyprland PPA you already have, and it
#      does NOT depend on Hyprland (it's a generic ext-session-lock client).
#      Supports blur, animated shaders, per-output wallpapers, and arbitrary
#      command output on the lock screen. The obvious upgrade if you want a
#      genuinely animated lock.
#
#   3. swaylock-effects -- blur/screenshot/clock, but a static image. Build
#      from source; see the block above.
