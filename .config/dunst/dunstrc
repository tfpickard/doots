# ~/.config/dunst/dunstrc  --  IndigoMagic beveled notifications (flat, chunky)
[global]
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 160)
    origin = top-right
    offset = (16, 40)
    scale = 0
    notification_limit = 6

    progress_bar = true
    progress_bar_height = 12
    progress_bar_frame_width = 2
    progress_bar_min_width = 160
    progress_bar_max_width = 320

    indicate_hidden = yes
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 0
    frame_width = 3
    frame_color = "#2a2d33"
    separator_color = "#1d5a68"
    corner_radius = 0
    gap_size = 4

    sort = yes
    font = DejaVu Sans 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    show_indicators = yes

    icon_position = left
    enable_recursive_icon_lookup = true

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#9398a8"
    foreground = "#14181c"
    frame_color = "#585c6b"
    timeout = 6

[urgency_normal]
    background = "#2c7a8c"
    foreground = "#f2f3f6"
    frame_color = "#1d5a68"
    timeout = 8

[urgency_critical]
    background = "#cf3030"
    foreground = "#f2f3f6"
    frame_color = "#7a2020"
    timeout = 0
