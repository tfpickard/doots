#!/usr/bin/env bash
# theme-set — global theme switcher.
#
# Every app reads its colors from ~/.config/themes/active/<snippet>, where
# `active` is a symlink to one of the theme directories here. Switching theme
# is therefore: flip the symlink, patch niri's tagged color lines (niri has no
# include mechanism), and poke each app to reload.
#
# Usage:
#   theme-set            fuzzel picker of available themes
#   theme-set aura       switch directly
#   theme-set --list     list themes
set -euo pipefail

THEMES_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
NIRI_CONFIG="$HOME/.config/niri/config.kdl"

list_themes() {
    find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

pick_theme() {
    list_themes | fuzzel --dmenu --prompt="theme> " --lines=8
}

case "${1:-}" in
    --list) list_themes; exit 0 ;;
    "")     theme="$(pick_theme)" || exit 1 ;;
    *)      theme="$1" ;;
esac

[ -d "$THEMES_DIR/$theme" ] || { echo "No such theme: $theme" >&2; exit 1; }
palette="$THEMES_DIR/$theme/palette.json"
[ -f "$palette" ] || { echo "Theme $theme has no palette.json" >&2; exit 1; }

# 1. Flip the master symlink. Everything else hangs off it.
ln -sfn "$THEMES_DIR/$theme" "$THEMES_DIR/active"

# 2. niri: patch the color lines tagged with THEME: markers, then reload.
if [ -f "$NIRI_CONFIG" ]; then
    accent=$(jq -r .accent "$palette")
    overlay=$(jq -r .overlay "$palette")
    red=$(jq -r .red "$palette")
    sed -i \
        -e "s|\(active-color \)\"[^\"]*\"\( // THEME:focus-active\)|\1\"$accent\"\2|" \
        -e "s|\(inactive-color \)\"[^\"]*\"\( // THEME:focus-inactive\)|\1\"$overlay\"\2|" \
        -e "s|\(urgent-color \)\"[^\"]*\"\( // THEME:focus-urgent\)|\1\"$red\"\2|" \
        "$NIRI_CONFIG"
    niri msg action load-config-file >/dev/null 2>&1 || true
fi

# 3. waybar: CSS @import of themes/active/waybar.css picks up the change on
#    style reload (SIGUSR2). Falls back to full restart if reload fails.
pkill -USR2 -x waybar 2>/dev/null || true

# 4. mako: whole config is a symlink to themes/active/mako.ini.
makoctl reload 2>/dev/null || true

# 5. ghostty: reads themes/active/ghostty via its config include on reload
#    (press ctrl+shift+, in ghostty, or open a new window).

# 6. fuzzel / gtk / fastfetch / bottom pick up the active symlink on next launch.

command -v notify-send >/dev/null && notify-send "Theme switched" "Now using: $theme" || true
echo "Theme set to: $theme"
