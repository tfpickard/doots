#!/usr/bin/env bash
# theme-set — global theme switcher.
#
# Every app reads its colors from ~/.config/themes/active/<snippet>, where
# `active` is a symlink to one of the theme directories here. Switching theme
# is therefore: flip the symlink, patch niri's tagged color lines (niri has no
# include mechanism), and poke each app to reload.
#
# Usage:
#   theme-set            fuzzel picker of available themes
#   theme-set aura       switch directly
#   theme-set --list     list themes
set -euo pipefail

THEMES_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
NIRI_CONFIG="$HOME/.config/niri/config.kdl"

# List theme directory names. `active` is a symlink-to-directory and must be
# excluded: `find -type d` did that implicitly (find does not follow symlinks),
# but the glob below matches it, so the -L guard is load-bearing.
list_themes() {
    local d
    for d in "$THEMES_DIR"/*/; do
        d=${d%/}
        [ -L "$d" ] && continue
        [ -d "$d" ] || continue
        printf '%s\n' "${d##*/}"
    done | sort
}

pick_theme() {
    list_themes | fuzzel --dmenu --prompt="theme> " --lines=8
}

# In-place sed that works with both BSD and GNU sed, which disagree on -i.
# The temp file is created beside the target so the rename stays on one
# filesystem: a cross-filesystem mv degrades to copy+unlink, changing the
# inode and clobbering permissions.
#
# Two more wrinkles handled here:
#   - mktemp creates the temp file 0600, and a bare mv onto the target would
#     carry that mode along, silently downgrading e.g. a 644 file to
#     owner-only. `cp -p` (POSIX, works on both BSD and GNU) copies the
#     target's current mode onto the temp file; the sed output redirection
#     that follows truncates-in-place and does not touch the mode, so it
#     survives the eventual mv. (Deliberately not `chmod --reference=`,
#     which is GNU-only, nor `stat -c`/`stat -f`, which disagree per
#     platform.)
#   - If the target is a symlink, mv'ing over it would replace the link
#     itself with a plain file, orphaning whatever it pointed to. Resolve to
#     the real path first and operate entirely on that, leaving the symlink
#     untouched.
sed_inplace() {
    local f=$1; shift
    local rt t

    if [ -L "$f" ]; then
        rt=$(readlink -f "$f") || return 1
    else
        rt=$f
    fi

    t=$(mktemp "$rt.XXXXXX") || return 1
    cp -p "$rt" "$t" 2>/dev/null || { rm -f "$t"; return 1; }

    if ! sed "$@" "$rt" >"$t" 2>/dev/null; then
        rm -f "$t"
        return 1
    fi

    if ! mv "$t" "$rt"; then
        rm -f "$t"
        return 1
    fi
}

# Sourcing with THEME_SET_LIB=1 defines the helpers and stops here, so the
# test suite can exercise them directly.
if [ -n "${THEME_SET_LIB:-}" ]; then
    return 0 2>/dev/null || true
fi

case "${1:-}" in
    --list) list_themes; exit 0 ;;
    "")     theme="$(pick_theme)" || exit 1 ;;
    *)      theme="$1" ;;
esac

[ -d "$THEMES_DIR/$theme" ] || { echo "No such theme: $theme" >&2; exit 1; }
palette="$THEMES_DIR/$theme/palette.json"
[ -f "$palette" ] || { echo "Theme $theme has no palette.json" >&2; exit 1; }

# 1. Flip the master symlink. Everything else hangs off it. The link is
#    created *relative* so it stores no machine identity and resolves
#    identically under /home/tom and /Users/tom.
( cd "$THEMES_DIR" && ln -sfn "$theme" active )

# 2. niri: patch the color lines tagged with THEME: markers, then reload.
if [ -f "$NIRI_CONFIG" ]; then
    accent=$(jq -r .accent "$palette")
    overlay=$(jq -r .overlay "$palette")
    red=$(jq -r .red "$palette")

    # Optional per-theme focus-ring gradient. A theme opts in by adding a
    # "focus_gradient": {"from","to","angle"} object to its palette.json.
    # The single line tagged "// THEME:focus-gradient" is rewritten either to a
    # live active-gradient node (takes precedence over the solid active-color
    # fallback) or to a comment when the theme has no gradient.
    grad=$(jq -r '
        if .focus_gradient then
            "active-gradient from=\"\(.focus_gradient.from)\" to=\"\(.focus_gradient.to)\" angle=\(.focus_gradient.angle // 45) relative-to=\"workspace-view\" in=\"oklch longer hue\""
        else "" end' "$palette")
    if [ -n "$grad" ]; then
        grad_line="        $grad // THEME:focus-gradient"
    else
        grad_line="        // no focus gradient for this theme // THEME:focus-gradient"
    fi

    sed -i \
        -e "s|\(active-color \)\"[^\"]*\"\( // THEME:focus-active\)|\1\"$accent\"\2|" \
        -e "s|\(inactive-color \)\"[^\"]*\"\( // THEME:focus-inactive\)|\1\"$overlay\"\2|" \
        -e "s|\(urgent-color \)\"[^\"]*\"\( // THEME:focus-urgent\)|\1\"$red\"\2|" \
        -e "s|^.*// THEME:focus-gradient\$|$grad_line|" \
        "$NIRI_CONFIG"
    niri msg action load-config-file >/dev/null 2>&1 || true
fi

# 3. waybar: CSS @import of themes/active/waybar.css picks up the change on
#    style reload (SIGUSR2). Falls back to full restart if reload fails.
pkill -USR2 -x waybar 2>/dev/null || true

# 4. mako: whole config is a symlink to themes/active/mako.ini.
makoctl reload 2>/dev/null || true

# 5. ghostty: reads themes/active/ghostty via its config include on reload
#    (press ctrl+shift+, in ghostty, or open a new window).

# 6. bottom: no include mechanism, so regenerate its [colors] block (between
#    "# >>> theme-set:colors" / "# <<< theme-set:colors" markers) from palette.
BOTTOM_CFG="$HOME/.config/bottom/bottom.toml"
if [ -f "$BOTTOM_CFG" ] && grep -q "# >>> theme-set:colors" "$BOTTOM_CFG"; then
    block=$(jq -r '
        "table_header_color = \"\(.accent)\"",
        "widget_title_color = \"\(.text)\"",
        "avg_cpu_color = \"\(.red)\"",
        "cpu_core_colors = [\"\(.accent)\", \"\(.accent2)\", \"\(.green)\", \"\(.orange)\", \"\(.blue)\", \"\(.pink)\", \"\(.yellow)\", \"\(.subtext)\"]",
        "ram_color = \"\(.accent)\"",
        "swap_color = \"\(.orange)\"",
        "gpu_core_colors = [\"\(.green)\", \"\(.blue)\", \"\(.pink)\"]",
        "rx_color = \"\(.accent2)\"",
        "tx_color = \"\(.green)\"",
        "border_color = \"\(.surface)\"",
        "highlighted_border_color = \"\(.accent)\"",
        "text_color = \"\(.text)\"",
        "selected_text_color = \"\(.bg)\"",
        "selected_bg_color = \"\(.accent)\"",
        "graph_color = \"\(.overlay)\"",
        "high_battery_color = \"\(.green)\"",
        "medium_battery_color = \"\(.orange)\"",
        "low_battery_color = \"\(.red)\""
    ' "$palette")
    awk -v block="$block" '
        /# >>> theme-set:colors/ { print; print "[colors]"; print block; skip=1; next }
        /# <<< theme-set:colors/ { skip=0; print; next }
        !skip { print }
    ' "$BOTTOM_CFG" > "$BOTTOM_CFG.tmp" && mv "$BOTTOM_CFG.tmp" "$BOTTOM_CFG"
fi

# 7. fastfetch: no include mechanism either. Rewrite the two truecolor ANSI
#    values (keys = accent, title = green) in-place, preserving structure.
FASTFETCH_CFG="$HOME/.config/fastfetch/config.jsonc"
if [ -f "$FASTFETCH_CFG" ]; then
    hex2ansi() { # "#rrggbb" -> "38;2;r;g;b"
        local h="${1#\#}"
        printf '38;2;%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
    }
    keys_ansi=$(hex2ansi "$(jq -r .accent "$palette")")
    title_ansi=$(hex2ansi "$(jq -r .green "$palette")")
    sed -i -E \
        -e "s|(\"keys\"[[:space:]]*:[[:space:]]*\")[0-9;]*(\")|\1$keys_ansi\2|" \
        -e "s|(\"title\"[[:space:]]*:[[:space:]]*\")[0-9;]*(\")|\1$title_ansi\2|" \
        "$FASTFETCH_CFG"
fi

# 8. tmux: colors live in themes/active/tmux.conf, sourced by ~/.tmux.conf.
#    Re-source it into every running server so open sessions update live.
if command -v tmux >/dev/null; then
    for sock in $(find /tmp/tmux-"$(id -u)" -type s 2>/dev/null); do
        tmux -S "$sock" source-file "$HOME/.config/themes/active/tmux.conf" 2>/dev/null || true
    done
fi

# 9. fuzzel / gtk pick up the active symlink on next launch.

command -v notify-send >/dev/null && notify-send "Theme switched" "Now using: $theme" || true
echo "Theme set to: $theme"
