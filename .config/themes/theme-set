#!/usr/bin/env bash
# theme-set — global theme switcher.
#
# Colors live in themes/<name>/. Switching is: flip the themes/active symlink,
# then poke each application that can pick the change up.
#
# Applications are *discovered*, not assumed. The APPLIERS table pairs a probe
# command with a target path, and an applier runs only when both are present.
# That is why this script contains no uname branching: macOS simply resolves
# fewer appliers than a Wayland desktop does.
#
# Usage:
#   theme-set            fuzzel picker of available themes
#   theme-set aura       switch directly
#   theme-set --list     list theme names
#   theme-set --check    report which appliers resolve here; change nothing
#
# Portability: must run on macOS's bash 3.2. No associative arrays, no
# mapfile, no ${var,,}, no GNU-only find/sed flags. Loops that mutate state
# use herestrings, never pipelines (bash 3.2 subshells the RHS of a pipe).
set -euo pipefail

THEMES_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# ------------------------------------------------------------------ helpers --

# List theme directory names. `active` is a symlink-to-directory and must be
# excluded: `find -type d` did that implicitly (find does not follow symlinks),
# but the glob below matches it, so the -L guard is load-bearing.
list_themes() {
    local d
    for d in "$THEMES_DIR"/*/; do
        d=${d%/}
        [ -L "$d" ] && continue
        [ -d "$d" ] || continue
        # A theme is a directory with a palette. This excludes `default/`,
        # which ships only a tmux fallback, and any stray directory.
        [ -f "$d/palette.json" ] || continue
        printf '%s\n' "${d##*/}"
    done | sort
}

pick_theme() {
    list_themes | fuzzel --dmenu --prompt="theme> " --lines=8
}

# In-place sed that works with both BSD and GNU sed, which disagree on -i.
# The temp file is created beside the target so the rename stays on one
# filesystem: a cross-filesystem mv degrades to copy+unlink, changing the
# inode and clobbering permissions.
#
# Two more wrinkles handled here:
#   - mktemp creates the temp file 0600, and a bare mv onto the target would
#     carry that mode along, silently downgrading e.g. a 644 file to
#     owner-only. `cp -p` (POSIX, works on both BSD and GNU) copies the
#     target's current mode onto the temp file; the sed output redirection
#     that follows truncates-in-place and does not touch the mode, so it
#     survives the eventual mv. (Deliberately not `chmod --reference=`,
#     which is GNU-only, nor `stat -c`/`stat -f`, which disagree per
#     platform.)
#   - If the target is a symlink, mv'ing over it would replace the link
#     itself with a plain file, orphaning whatever it pointed to. Resolve to
#     the real path first and operate entirely on that, leaving the symlink
#     untouched.
sed_inplace() {
    local f=$1; shift
    local rt t

    if [ -L "$f" ]; then
        rt=$(readlink -f "$f") || return 1
    else
        rt=$f
    fi

    t=$(mktemp "$rt.XXXXXX") || return 1
    cp -p "$rt" "$t" 2>/dev/null || { rm -f "$t"; return 1; }

    if ! sed "$@" "$rt" >"$t" 2>/dev/null; then
        rm -f "$t"
        return 1
    fi

    if ! mv "$t" "$rt"; then
        rm -f "$t"
        return 1
    fi
}

# Rewrite the value on the line directly BELOW a "<prefix><key>" marker
# comment, for configs with no include mechanism at all (swaylock, fnott).
# The marker sits on its own line because swaylock does NOT strip trailing
# "#" comments -- it would read "0f1113  # THEME:lock-bg" as the literal
# colour and fall back to white.
#
# $4 is an optional alpha suffix for configs that want rrggbbaa. When it is
# empty an existing 8-digit value keeps its own alpha rather than losing it.
#
# Editing goes through the same symlink/mode discipline as sed_inplace: these
# files are deployed by symlinking into $HOME, so a plain `mv` over the target
# would swap the link for a regular file and detach it from the repo. The map
# is read with a herestring, not a pipe, so a failure inside the loop can
# actually return (bash 3.2 subshells the RHS of a pipe).
patch_marked_values() { # file marker-prefix map [alpha-suffix]
    local file=$1 prefix=$2 map=$3 alpha=${4:-}
    local rt key color hex t

    [ -e "$file" ] || return 0
    if [ -L "$file" ]; then
        rt=$(readlink -f "$file") || return 1
    else
        rt=$file
    fi

    while read -r key color; do
        [ -n "$key" ] || continue
        hex=${color#\#}
        t=$(mktemp "$rt.XXXXXX") || return 1
        cp -p "$rt" "$t" 2>/dev/null || { rm -f "$t"; return 1; }
        if ! awk -v key="${prefix}${key}" -v hex="$hex" -v alpha="$alpha" '
            {
                if (prev == key && $0 ~ /^[a-z0-9-]+=/) {
                    # Preserve an existing 8-digit (rrggbbaa) value: take the
                    # old alpha rather than dropping it, unless one is given.
                    split($0, kv, "=")
                    old = kv[2]
                    a = alpha
                    if (a == "" && length(old) == 8) a = substr(old, 7, 2)
                    sub(/=.*/, "=" hex a)
                }
                print; prev = $0
            }
        ' "$rt" >"$t" 2>/dev/null; then
            rm -f "$t"
            return 1
        fi
        if ! mv "$t" "$rt"; then
            rm -f "$t"
            return 1
        fi
    done <<< "$map"
}

hex2ansi() { # "#rrggbb" -> "38;2;r;g;b"
    local h="${1#\#}"
    printf '38;2;%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

pal() { jq -r ".$1" "$PALETTE"; }

# ----------------------------------------------------------------- appliers --
# Applications that read themes/active directly need no poking; flipping the
# symlink is the entire operation for them.
apply_ghostty() { :; }   # reload with ctrl+shift+, or open a new window
apply_fuzzel()  { :; }   # include= is re-read on next launch
apply_gtk()     { :; }   # symlink is re-read on next launch

apply_mako()   { makoctl reload 2>/dev/null || true; }
apply_waybar() { pkill -USR2 -x waybar 2>/dev/null || true; }

apply_tmux() {
    local sock
    for sock in $(find "/tmp/tmux-$(id -u)" -type s 2>/dev/null); do
        tmux -S "$sock" source-file "$THEMES_DIR/active/tmux.conf" 2>/dev/null || true
    done
}

# niri has no include mechanism, so its color lines carry // THEME: markers
# that get rewritten in place.
apply_niri() {
    local accent overlay red grad grad_line
    accent=$(pal accent)
    overlay=$(pal overlay)
    red=$(pal red)

    # A theme opts into a focus-ring gradient by adding a "focus_gradient"
    # object to palette.json. The tagged line becomes either a live
    # active-gradient node or a comment.
    grad=$(jq -r '
        if .focus_gradient then
            "active-gradient from=\"\(.focus_gradient.from)\" to=\"\(.focus_gradient.to)\" angle=\(.focus_gradient.angle // 45) relative-to=\"workspace-view\" in=\"oklch longer hue\""
        else "" end' "$PALETTE")
    if [ -n "$grad" ]; then
        grad_line="        $grad // THEME:focus-gradient"
    else
        grad_line="        // no focus gradient for this theme // THEME:focus-gradient"
    fi

    sed_inplace "$HOME/.config/niri/config.kdl" \
        -e "s|\(active-color \)\"[^\"]*\"\( // THEME:focus-active\)|\1\"$accent\"\2|" \
        -e "s|\(inactive-color \)\"[^\"]*\"\( // THEME:focus-inactive\)|\1\"$overlay\"\2|" \
        -e "s|\(urgent-color \)\"[^\"]*\"\( // THEME:focus-urgent\)|\1\"$red\"\2|" \
        -e "s|^.*// THEME:focus-gradient\$|$grad_line|"
    niri msg action load-config-file >/dev/null 2>&1 || true
}

# bottom has no include mechanism either; regenerate its [colors] block
# between the theme-set markers.
apply_bottom() {
    local cfg="$HOME/.config/bottom/bottom.toml" block t
    grep -q "# >>> theme-set:colors" "$cfg" || return 0
    block=$(jq -r '
        "table_header_color = \"\(.accent)\"",
        "widget_title_color = \"\(.text)\"",
        "avg_cpu_color = \"\(.red)\"",
        "cpu_core_colors = [\"\(.accent)\", \"\(.accent2)\", \"\(.green)\", \"\(.orange)\", \"\(.blue)\", \"\(.pink)\", \"\(.yellow)\", \"\(.subtext)\"]",
        "ram_color = \"\(.accent)\"",
        "swap_color = \"\(.orange)\"",
        "gpu_core_colors = [\"\(.green)\", \"\(.blue)\", \"\(.pink)\"]",
        "rx_color = \"\(.accent2)\"",
        "tx_color = \"\(.green)\"",
        "border_color = \"\(.surface)\"",
        "highlighted_border_color = \"\(.accent)\"",
        "text_color = \"\(.text)\"",
        "selected_text_color = \"\(.bg)\"",
        "selected_bg_color = \"\(.accent)\"",
        "graph_color = \"\(.overlay)\"",
        "high_battery_color = \"\(.green)\"",
        "medium_battery_color = \"\(.orange)\"",
        "low_battery_color = \"\(.red)\""
    ' "$PALETTE")
    # $block came from jq and carries embedded newlines; feeding it to awk via
    # `-v` breaks on macOS's /usr/bin/awk (BWK awk, not gawk), which rejects a
    # -v assignment containing a literal newline ("newline in string ... at
    # source line 1", exit 2) before the temp file is ever written. A plain
    # bash line-by-line copy sidesteps awk entirely and works identically on
    # BWK awk, gawk, or no awk at all.
    local line skip=0
    t=$(mktemp "$cfg.XXXXXX") || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            *'# >>> theme-set:colors'*)
                printf '%s\n[colors]\n%s\n' "$line" "$block"
                skip=1
                ;;
            *'# <<< theme-set:colors'*)
                printf '%s\n' "$line"
                skip=0
                ;;
            *)
                [ "$skip" -eq 1 ] || printf '%s\n' "$line"
                ;;
        esac
    done < "$cfg" >"$t" && mv "$t" "$cfg"
}

apply_fastfetch() {
    local cfg="$HOME/.config/fastfetch/config.jsonc" keys_ansi title_ansi
    keys_ansi=$(hex2ansi "$(pal accent)")
    title_ansi=$(hex2ansi "$(pal green)")
    sed_inplace "$cfg" -E \
        -e "s|(\"keys\"[[:space:]]*:[[:space:]]*\")[0-9;]*(\")|\1$keys_ansi\2|" \
        -e "s|(\"title\"[[:space:]]*:[[:space:]]*\")[0-9;]*(\")|\1$title_ansi\2|"
}

# The two lock screens share one key map. Both configs are currently pinned to
# the SGI palette and carry NO "THEME:" markers, so these appliers are a
# deliberate no-op -- patch_marked_values only substitutes where a marker
# matches. They stay wired so that re-adding a marker is all it takes to put
# the lock back under theme control, exactly as those configs document.
lock_map() {
    jq -r '
        {
            "lock-bg":     .bg_dark,
            "lock-inside": .surface,
            "lock-ring":   .overlay,
            "lock-text":   .text,
            "lock-keyhl":  .accent,
            "lock-bshl":   .red,
            "lock-ver":    .blue,
            "lock-wrong":  .red,
            "lock-clear":  .green,
            "lock-caps":   .orange
        } | to_entries[] | "\(.key) \(.value)"' "$PALETTE"
}

apply_swaylock() {
    patch_marked_values "$HOME/.config/swaylock/config" "# THEME:" "$(lock_map)"
}

apply_swaylock_effects() {
    patch_marked_values "$HOME/.config/swaylock-effects/config" "# THEME:" "$(lock_map)"
}

# fnott uses the same marker convention but wants RGBA (8 hex digits), so the
# alpha is appended explicitly per key. Backgrounds keep their own
# translucency and are therefore patched separately from the solid colours.
apply_fnott() {
    local cfg="$HOME/.config/fnott/fnott.ini" solid bg
    solid=$(jq -r '
        {
            "fnott-border":        .surface,
            "fnott-title":         .subtext,
            "fnott-summary":       .text,
            "fnott-body":          .subtext,
            "fnott-progress":      .accent,
            "fnott-low-summary":   .subtext,
            "fnott-low-body":      .overlay,
            "fnott-crit-border":   .red,
            "fnott-crit-summary":  .red,
            "fnott-crit-body":     .text
        } | to_entries[] | "\(.key) \(.value)"' "$PALETTE")
    patch_marked_values "$cfg" "# THEME:" "$solid" "ff"

    bg=$(pal bg)
    patch_marked_values "$cfg" "# THEME:" "fnott-bg $bg"      "ee"
    patch_marked_values "$cfg" "# THEME:" "fnott-low-bg $bg"  "cc"
    patch_marked_values "$cfg" "# THEME:" "fnott-crit-bg $bg" "f5"

    # Reload only if fnott is the notification daemon currently running.
    pgrep -x fnott >/dev/null 2>&1 && pkill -USR1 -x fnott 2>/dev/null || true
}

# swaync reads CSS, and its colors.css is a symlink to themes/active/waybar.css
# just like the waybar theme, so flipping the symlink is the whole change and
# it only needs a reload.
apply_swaync() {
    pgrep -x swaync >/dev/null 2>&1 || return 0
    swaync-client -rs >/dev/null 2>&1 || true
}

# neovim: every running instance auto-creates a socket in $XDG_RUNTIME_DIR
# (e.g. /run/user/1000/nvim.<pid>.0). nvim has no config-include mechanism for
# colours, and only one of the themes here has a matching colorscheme plugin,
# so the config builds its own colorscheme from palette.json
# (lua/util/theme.lua) and exposes :Theme to re-read it. Poke each live
# instance so open editors follow the switch without a restart.
#
# --remote-expr rather than --remote-send: it runs in the target without
# touching its input state, so it can't corrupt a pending mapping or an
# insert-mode buffer the way injected keystrokes can. Each call is
# backgrounded with a timeout because a wedged nvim would otherwise block the
# whole theme switch.
apply_nvim() {
    local sock
    for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*; do
        [ -S "$sock" ] || continue
        timeout 2 nvim --server "$sock" --remote-expr \
            "execute('silent! Theme')" >/dev/null 2>&1 &
    done
    wait 2>/dev/null || true
}

# ----------------------------------------------------------------- dispatch --
# name|probe command ("-" = no command probe)|target path|apply function
appliers_table() {
    cat <<EOF
ghostty|ghostty|$HOME/.config/ghostty|apply_ghostty
tmux|tmux|$HOME/.tmux.conf|apply_tmux
bottom|btm|$HOME/.config/bottom/bottom.toml|apply_bottom
fastfetch|fastfetch|$HOME/.config/fastfetch/config.jsonc|apply_fastfetch
niri|niri|$HOME/.config/niri/config.kdl|apply_niri
waybar|waybar|$HOME/.config/waybar|apply_waybar
mako|makoctl|$HOME/.config/mako|apply_mako
fuzzel|fuzzel|$HOME/.config/fuzzel|apply_fuzzel
gtk|-|$HOME/.config/gtk-4.0|apply_gtk
swaylock|swaylock|$HOME/.config/swaylock/config|apply_swaylock
swaylock-fx|swaylock|$HOME/.config/swaylock-effects/config|apply_swaylock_effects
fnott|fnott|$HOME/.config/fnott/fnott.ini|apply_fnott
swaync|swaync-client|$HOME/.config/swaync|apply_swaync
nvim|nvim|$HOME/.config/nvim|apply_nvim
EOF
}

# Echo nothing if the applier is usable here, else a human-readable reason.
applier_skip_reason() { # probe target
    if [ "$1" != "-" ] && ! command -v "$1" >/dev/null 2>&1; then
        printf '%s not installed' "$1"
    elif [ ! -e "$2" ]; then
        printf '%s missing' "$2"
    fi
}

check_appliers() {
    local name probe target fn reason
    while IFS='|' read -r name probe target fn; do
        [ -z "$name" ] && continue
        reason=$(applier_skip_reason "$probe" "$target")
        if [ -z "$reason" ]; then
            printf '  apply  %-11s\n' "$name"
        else
            printf '  skip   %-11s (%s)\n' "$name" "$reason"
        fi
    done <<< "$(appliers_table)"
}

run_appliers() {
    local name probe target fn reason failed
    failed=0
    while IFS='|' read -r name probe target fn; do
        [ -z "$name" ] && continue
        reason=$(applier_skip_reason "$probe" "$target")
        if [ -n "$reason" ]; then
            printf '  skip   %-11s (%s)\n' "$name" "$reason"
            continue
        fi
        if "$fn"; then
            printf '  ok     %-11s\n' "$name"
        else
            printf '  ERROR  %-11s\n' "$name" >&2
            failed=1
        fi
    done <<< "$(appliers_table)"
    return "$failed"
}

# Sourcing with THEME_SET_LIB=1 defines the helpers and stops here, so the
# test suite can exercise them directly.
if [ -n "${THEME_SET_LIB:-}" ]; then
    return 0 2>/dev/null || true
fi

# --------------------------------------------------------------------- main --
case "${1:-}" in
    --list)  list_themes; exit 0 ;;
    --check) check_appliers; exit 0 ;;
    "")      theme="$(pick_theme)" || exit 1 ;;
    *)       theme="$1" ;;
esac

[ -d "$THEMES_DIR/$theme" ] || { echo "No such theme: $theme" >&2; exit 1; }
PALETTE="$THEMES_DIR/$theme/palette.json"
[ -f "$PALETTE" ] || { echo "Theme $theme has no palette.json" >&2; exit 1; }

# Flip the master symlink. Everything else hangs off it. Created *relative* so
# it stores no machine identity and resolves under /home/tom and /Users/tom.
( cd "$THEMES_DIR" && ln -sfn "$theme" active )

# Every applier is attempted regardless of earlier failures (run_appliers
# never aborts early); its exit status only reflects whether any applier
# failed, which is deliberately captured here rather than let `set -e` act on
# it directly, so the symlink flip and final message above always happen.
appliers_failed=0
run_appliers || appliers_failed=$?

command -v notify-send >/dev/null 2>&1 && \
    notify-send "Theme switched" "Now using: $theme" || true
echo "Theme set to: $theme"

exit "$appliers_failed"
