[Icon Theme]
# Makes the pixel-art cursor the session-wide default without touching
# anything system-wide. Xcursor looks up ~/.icons/default and follows
# "Inherits", which is how XWayland and legacy X11 apps find the theme --
# niri's own `cursor { xcursor-theme }` block only covers Wayland clients.
#
# dmz-white-4bit is generated by ~/.config/scripts/pixelate-cursors.py.
Name=Default
Comment=Default cursor theme -> 4-bit pixel pointer
Inherits=dmz-white-4bit
